# Local development only. Copy to `.env` and fill in real values.
#
#   cp .env.example .env
#
# `.env` is git-ignored and must NEVER be committed. In CI these
# same names come from GitHub repository secrets instead -- the
# code reads process.env either way, so there is exactly one code
# path (see package.json: --env-file-if-exists).

# ── Google Sheets access ─────────────────────────────────────

# The ENTIRE contents of the service-account JSON key file, as a
# single line. Get it from: Google Cloud Console -> IAM & Admin ->
# Service Accounts -> your account -> Keys -> Add key -> JSON.
#
# Then share the actual Google Sheet with that key's `client_email`
# (Editor access), exactly like sharing with a person. That share
# is what grants access -- no project-level IAM role is needed.
#
# Note: the JSON contains a `private_key` with embedded newlines.
# Paste it as-is; the code handles both real newlines and the
# escaped "\n" form that some shells and secret UIs produce.
GOOGLE_SERVICE_ACCOUNT_JSON=

# The target spreadsheet's ID -- the long string in its URL:
#   https://docs.google.com/spreadsheets/d/<THIS PART>/edit
# Kept as a secret rather than a committed constant: it is not a
# credential, but it identifies private financial data.
SPREADSHEET_ID=

# Three spreadsheets (docs/SHEETS_CLEANUP_PLAN.md (d)): the report tabs and the
# machine data move out of My Portfolio into two spreadsheets of their own.
# Leaving these empty is fine: nothing changes until the migration tool
# (npm run migrate-data-tabs) has copied and verified the tabs and set the
# flag on My Portfolio. An empty value counts as unset.
REPORTS_SPREADSHEET_ID=
DATA_SPREADSHEET_ID=

# ── Market data providers ────────────────────────────────────
# These already exist in the legacy Apps Script project. Move the
# real values here; do not commit them anywhere.
FMP_API_KEY=
ALPHAVANTAGE_KEY=
FINNHUB_KEY=

# ── AI providers ─────────────────────────────────────────────
GEMINI_API_KEY=

# Not needed until phase 6 (Opus integration). Leave blank until
# the Anthropic account and billing are set up.
ANTHROPIC_API_KEY=

# ── Clock ────────────────────────────────────────────────────
# Replaces Apps Script's Session.getScriptTimeZone(). Decided
# 2026-10-22: the market's own zone. Not a secret.
SCRIPT_TIME_ZONE=America/New_York

# ── SEC EDGAR ────────────────────────────────────────────────
# A real contact email. It becomes the SEC User-Agent ("Mozilla/5.0 <this>").
# Not a credential. In CI it comes from the SEC_CONTACT_EMAIL secret.
SEC_CONTACT_EMAIL=

# Telegram delivery (bot key from @BotFather; chat number from `npm run telegram-check`). Secrets in CI.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# One-time relay setup only (the same random text is saved in the Cloudflare relay)
TELEGRAM_WEBHOOK_SECRET=
