# ── Dependencies & build output ──────────────────────────────
node_modules/
dist/
*.tsbuildinfo

# ── Secrets: NOTHING in here may ever be committed ───────────
# The service-account key and all 7 API keys live in GitHub
# Secrets (CI) or a local .env (dev). See .env.example for the
# list of names. If you are ever unsure whether something is a
# secret, it is.
.env
.env.*
!.env.example

# Google service-account key files, under any plausible name.
# The correct place for these is the GOOGLE_SERVICE_ACCOUNT_JSON
# secret -- never a file on disk, and never on a CI runner.
*-service-account*.json
*service-account*.json
*credentials*.json
*client_secret*.json
gcp-key*.json

# ── OS / editor junk ─────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# ── Local scratch ────────────────────────────────────────────
*.local
tmp/
out/
